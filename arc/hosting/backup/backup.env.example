# /etc/backup/backup.env — K-48 (srr/scmp.md § 11). root's, mode 0600: backup.sh refuses
# anything else. The R2 token is scoped to the bucket; the identity is on no box.
BACKUP_R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
BACKUP_R2_BUCKET=wallflowers-backup
BACKUP_R2_ACCESS_KEY_ID=
BACKUP_R2_SECRET_ACCESS_KEY=
BACKUP_AGE_RECIPIENT=age1…
