# /etc/arc/arc.env for a rehearsal box (door-test, K-43), installed by `deploy-arc.sh
# setup`. The KEYS are production's exactly, as Ralph read them on kenjin-01 (D-51 (c)),
# plus RELAY_MAX_BLOB_BYTES, which go-live's step 1 adds. The VALUES are the rehearsal's:
# loopback only, no credential, nothing of production's. Every other key a plane reads
# runs on its default, in production too (O-46).
#
# PORT is not set here: EnvironmentFile overrides a unit's Environment=, and each unit
# sets its own.

ARC_NAME=door-test-rehearsal
# A-3: the kiosk keys, shipped by deploy-arc.sh (ARC_CLAIM_KEYS_FILE=hosting/claim-keys.rehearsal.json).
ARC_CLAIM_KEYS=/etc/arc/claim-keys.json
# The route a rehearsal's tethers carry: its own relay, so a rehearsal member never dials production.
ARC_PUBLIC_URL=ws://127.0.0.1:8787/v1/relay
# The node's identity is id_ed25519 here; there is no node/.
PACIFIC_STATE_DIR=/opt/arc/state
# Read by arcup only. The gateway takes its unit's PORT.
ARC_GATEWAY_PORT=8090
ARC_RELAY_UPSTREAM=ws://127.0.0.1:8787
ARC_MEMBERSHIP_UPSTREAM=http://127.0.0.1:8790
ARC_BOXOFFICE_UPSTREAM=http://127.0.0.1:8793
ARC_WAKER_UPSTREAM=http://127.0.0.1:8794
RELAY_BIND=127.0.0.1:8787
RELAY_STORE=/opt/arc/state/relay.db
ARC_RELAY_URL=ws://127.0.0.1:8787
# All four present, as production's are, so media offload is on; nothing listens at
# the endpoint and the key is not one. The relay starts, its usage poll fails, and the
# budget fails closed: every MediaPut and MediaGet is refused, and messaging is not
# touched (the mailbox stays in RELAY_STORE: RELAY_MAILBOX_BLOBS is unset).
RELAY_R2_ENDPOINT=http://127.0.0.1:9
RELAY_R2_BUCKET=rehearsal
RELAY_R2_ACCESS_KEY_ID=rehearsal
RELAY_R2_SECRET_ACCESS_KEY=rehearsal
RELAY_R2_REGION=auto
# Default 8 GiB. The VM's disk is 40 GiB.
RELAY_MAX_STORE_BYTES=2147483648
# K-40, NC-27: the Egregore Site's Welcome.
RELAY_MAX_BLOB_BYTES=1048576
