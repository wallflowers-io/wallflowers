# arc-node.service — the Arc's node (S-18), in kenjin-01's shape as SCM read it on 27 Sep (D-51).
# __ARC_USER__ is filled by deploy-arc.sh setup (ARC_USER; ubuntu on kenjin-01).
[Unit]
Description=Arc node (S-18)
After=network-online.target
Wants=network-online.target

[Service]
User=__ARC_USER__
EnvironmentFile=/etc/arc/arc.env
Environment=PORT=8790
WorkingDirectory=/opt/arc/state
ExecStart=/opt/arc/bin/node

[Install]
WantedBy=multi-user.target
