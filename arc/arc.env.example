# arc.env — the whole config for one Arc, consumed by ./arcup.
# Copy to arc.env (gitignored) and edit. Everything here is also settable as plain env
# (Railway vars, systemd Environment=, docker -e), so this file is optional.

# ── target: selects a profile of defaults + the secrets provider (NOT a launcher branch)
ARC_TARGET=local            # local | machine0 | railway
ARC_NAME=arc.1

# ── components ────────────────────────────────────────────────────────────────
ARC_RELAY=on                # on | off   — semaphore, MLS router
ARC_CONSOLE=on              # on | off   — arc-node: /arc /signup /tether /bundle /console
ARC_SPATIAL=off             # off | mlx | proxy          (Kenjin geometry)
ARC_BOXOFFICE=on            # on | off   — event ticketing (/v1/box); free path works without secrets
ARC_WAKER=on                # on | off   — APNs push (/v1/wake); registration works without secrets
# ARC_SPATIAL_CMD=...        # command to launch the spatial server — REQUIRED for mlx|proxy
#                            #   (no spatial server ships in the image)

# ── volumes ───────────────────────────────────────────────────────────────────
# ARC_STATE_DIR=...          # identity (id_ed25519) + pacific.db — MUST persist. default per target:
#                            #   local ~/.arc-state · machine0 /data/arc · railway /data
# RELAY_STORE=...            # the relay's DURABLE mailbox. default: $ARC_STATE_DIR/relay.db
#                            # MUST be on a persisted volume. A relay restart with no store
#                            # drops undrained blobs AND re-opens claimed commit slots, which
#                            # can fork a group. Set to "" to run ephemeral on purpose.

# ── networking ────────────────────────────────────────────────────────────────
ARC_BIND=0.0.0.0
ARC_RELAY_PORT=8787
ARC_CONSOLE_PORT=8790        # arc-node http (on railway, $PORT overrides this automatically)
ARC_SPATIAL_PORT=8791
ARC_BOXOFFICE_PORT=8793
ARC_WAKER_PORT=8794          # NOT 8795 — the systems plane already owns that port
# ARC_PUBLIC_URL=wss://arc.wallflowers.io/v1/relay # the route tethers carry; default ws://127.0.0.1:<gateway>/v1/relay
# ARC_RELAY_URL=wss://arc.wallflowers.io/v1/relay   # advertised in /arc for the app; default ws://127.0.0.1:<relay>
# ARC_APP_ORIGIN=https://app.wallflowers.io        # the webapp's origin: GET /v1/bundle answers CORS for it alone (W-103); unset, none

# ── relay retention ───────────────────────────────────────────────────────────
# NOTHING EXPIRES BY DEFAULT. The relay cannot know whether anyone drained, so an
# age window is not a storage setting — it is a deadline on being offline, and a
# phone that spends a week in a drawer has to come back to all of its mail.
# Set a limit only with a real volume problem in evidence. Past one, a device is
# told its history has a hole (Frame::Gap) rather than handed a short replay it
# cannot tell from a complete one.
# RELAY_RETENTION_SECS=0         # 0 (the default) = never expire by age
# RELAY_MAX_BLOBS_PER_TAG=0      # 0 (the default) = uncapped; else the oldest over the cap go
# RELAY_SWEEP_SECS=300           # how often the sweep runs; it never starts while both are 0
#
# SINCE 18 SEP 2026 THE RELAY IS THE STORE OF RECORD — the wrap, the head, the way-in
# entries all live here — so either knob above DESTROYS RECORDS, not just old mail.
# Leave both at 0.

# ── relay admission ───────────────────────────────────────────────────────────
# Every Pub is signed by the key its tag IS, and refused otherwise — that is not a
# setting. These bound HOW MUCH and HOW FAST, which is v1's whole answer to someone
# minting addresses of their own (proof of work and write tokens were evaluated and
# rejected, 18 Sep 2026). The store FAILS CLOSED: at the ceiling it refuses every
# write and never evicts. Refusals are named on the wire (Ack.reason) and counted in
# the stats line; none is logged beside a tag. See planes/relay/src/limits.rs.
# RELAY_MAX_BLOB_BYTES=262144          # one Pub, as sent
# RELAY_MAX_STORE_BYTES=8589934592     # the ceiling; 0 = none (never in production)
# RELAY_CONN_PUBS_PER_SEC=50           # per connection…
# RELAY_CONN_PUB_BURST=200
# RELAY_CONN_BYTES_PER_SEC=2097152
# RELAY_CONN_BYTES_BURST=16777216
# RELAY_CONN_NEW_TAGS_PER_MIN=120      # …and NEW addresses, the cheap thing a flood has
# RELAY_CONN_NEW_TAG_BURST=300
# RELAY_INGEST_BYTES_PER_SEC=33554432  # the whole relay
# RELAY_INGEST_BYTES_BURST=134217728

# ── identity ──────────────────────────────────────────────────────────────────
# Minted once into ARC_STATE_DIR on first boot (arc-node). Nothing to set unless relocating.

# ── secrets ───────────────────────────────────────────────────────────────────
ARC_SECRETS=env             # env | bws | systemd-creds
# bws:           needs BWS_ACCESS_TOKEN (+ BWS_SERVER_URL for EU); pulls the machine account's secrets into env
# systemd-creds: reads decrypted creds from $CREDENTIALS_DIRECTORY (one file per name)
# ARC_HEARTBEAT_TOKEN etc. arrive via whichever provider above
# STRIPE_SECRET_KEY / STRIPE_WEBHOOK_SECRET — the boxoffice plane's rail. WITHOUT them the
#   plane logs loud and serves the free path only (priced checkout 503s); it never dies.
#
# APNS_* — the waker plane's push credential (an APNs auth key from developer.apple.com →
#   Keys, with APNs enabled; an App Store Connect .p8 is NOT one). WITHOUT them the plane
#   logs loud, still accepts and STORES registrations (so no device has to re-register when
#   a key arrives), reports waker:false, and wakes nobody. It never dies.
# APNS_KEY_P8=...            # the .p8 PKCS#8 PEM CONTENTS (systemd-creds injects this)
# APNS_KEY_PATH=...          # local-dev alternative: a path to the .p8, read at startup
# APNS_KEY_ID=5W68RMT84R     # the key id — the JWT `kid`
# APNS_TEAM_ID=9LFA85922G    # the Apple developer team — the JWT `iss`
# APNS_TOPIC=network.pacific # the app bundle id
# APNS_SANDBOX=1             # 0 ⇒ production; anything else (incl. unset) ⇒ sandbox.
#   THE FLAG PICKS THE HOST, nothing is inferred: a device token is only valid for the
#   environment its app was signed for, so a development-signed build (Pacific today) MUST
#   use sandbox or every push answers BadDeviceToken.
# ARC_WAKER_DEDUPE_MS=10000  # at most one push per (token, tag) in this window
# ARC_WAKER_POLL_MS=15000    # how often the registration set is re-read and re-SUBbed

# ── Relay media offload (R2) ──────────────────────────────────────────────────
# Ciphertext goes client -> R2 DIRECTLY on a presigned URL; the relay signs the URL
# and never sees the bytes. That is what keeps the blind tier blind at media size —
# routing media THROUGH the relay would put every photo in the one process that is
# supposed to hold nothing.
#
# ALL FOUR or none: media.rs refuses to run half-configured (a partial set disables
# offload and MediaPut/MediaGet are refused, loudly). Live values for kenjin live in
# kenjin/site/.env — do not copy them here, source them.
#
#   RELAY_R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # = S3_API_ENDPOINT
#   RELAY_R2_BUCKET=pacific-media
#   RELAY_R2_ACCESS_KEY_ID=...                                    # = R2_ACCESS_KEY_ID
#   RELAY_R2_SECRET_ACCESS_KEY=...                                # = R2_SECRET_ACCESS_KEY
#
# Optional:
#   RELAY_R2_REGION=auto            # R2 wants "auto"; the default
#   RELAY_R2_BUDGET_BYTES=          # storage cap; 0 = UNCAPPED (nothing stops the bill)
#   RELAY_R2_USAGE_POLL_SECS=

# ── mailbox blob offload (18 Sep 2026) ────────────────────────────────────────
# WHERE THE MAILBOX BODIES REST. Separate from the media path above: that one is
# the CLIENT writing a photo to R2 with a URL the relay minted; this one is the
# ARC writing mailbox blobs to R2 itself.
#
#   RELAY_MAILBOX_BLOBS=sqlite   # the DEFAULT. index and bodies in RELAY_STORE.
#   RELAY_MAILBOX_BLOBS=r2       # index in RELAY_STORE, bodies in the R2 bucket above.
#
# The INDEX NEVER MOVES, and that is the design rather than a staging post. The
# commit slot's first-writer-wins arbitration, the retention floors and the seq
# high-water are transactional, and object storage has no transaction — a slot
# claimed for a blob that was never stored wedges a group-epoch, and a slot
# re-opened by a restart forks the group. See planes/relay/src/offload.rs.
#
# What r2 costs, so nobody discovers it in production:
#   * a replay is one GET per blob (batched 16 at a time) and it runs while the
#     hub mutex is held — a large drain stalls every other connection;
#   * mailbox bodies land in the SAME bucket the media budget meters, and they are
#     NOT gated by RELAY_R2_BUDGET_BYTES (refusing to store mail on a cost budget
#     would be data loss, not thrift). They do consume it, so a busy mailbox can be
#     what makes media presigns start being refused.
#
# It REFUSES TO START if RELAY_STORE is unset, if RELAY_R2_* is incomplete, or if
# the value is neither of the two above.
