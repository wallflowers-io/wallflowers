# kenjin-auth — copy to ../.env.auth (outside auth/, which deploys sync) and fill in.
# NOTHING here belongs in git.
#
# There are no provider blocks any more: the service authenticates a signature
# over a nonce it issued, so there is no door to configure, no mailer to wire
# and no secret to sign cookies with.

# ── required ────────────────────────────────────────────────────────────────
# The audience devices sign for is derived from this (the host part), so it has
# to match what the user handle carries. Override with AUTH_AUDIENCE only if
# they genuinely differ.
PUBLIC_ORIGIN=https://kenjin.cc

# ── storage ─────────────────────────────────────────────────────────────────
# MUST be on a persistent volume. On the VM this is a bind mount; losing it
# loses every account's wrap and history.
DB_PATH=/data/auth.db

# ── caps ────────────────────────────────────────────────────────────────────
# A wrap is a 76-byte envelope; the default ceiling is generous and still too
# small to store a file in. A history carries an archive and MLS state, so it is
# the one that can actually grow.
# WRAP_MAX_BYTES=4096
# HISTORY_MAX_BYTES=67108864

# ── Replication (Litestream -> R2) ──────────────────────────────────────────
# Continuous, WAL-aware replication of the account store to object storage.
# Most of the data lives in the -wal between checkpoints, so a cron job copying
# auth.db would back up an almost-empty file and report success.
R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
R2_BUCKET=kenjin-auth-backups
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── the Arc this deployment hosts accounts on ───────────────────────────────
# Anyone can run one (arc-node is a binary, the protocol is open). This is the
# default recorded for NEW accounts; each account records the Arc it was
# hosted on.
ARC_URL=https://arc.kenjin.cc
