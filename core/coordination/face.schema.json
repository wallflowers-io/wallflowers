{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://wallflowers.io/schema/face.schema.json",
 "title": "A Site's face",
 "$comment": "The face document group.editFace carries (ICD group.setFace: a JSON object, at most 16384 bytes). Every writer builds to this and every reader draws from it: the webapp's editor (face.js), the iOS editor, core's check before a site_* write (pacific-core face_spec.rs), and the Arc's renderer (arc/lib/face-render). Pictures are not here: they are the Host's media slots (host.editMedia: mark, cover, logo, wallpaper), so every picture field is empty. The keywords used are a subset core checks: type, properties, required, additionalProperties false, enum, const, minimum, maximum, maxLength, maxItems, items, oneOf by `type` const, $ref to $defs. x-wf-format names a check by value: hex-colour (#RRGGBB), font and sticker (the ids x-wf-builtins lists, and those in the editor's generated face-assets.js). x-wf-labels and the x-wf-* tables are what an editor shows.",
 "x-wf-maxBytes": 16384,
 "x-wf-address": "https://wallflowers.io/",
 "type": "object",
 "properties": {
  "look": {
   "$ref": "#/$defs/look"
  },
  "header": {
   "type": "object",
   "properties": {
    "layout": {
     "type": "string",
     "enum": [
      "classic",
      "hero",
      "banner"
     ],
     "x-wf-labels": {
      "classic": "Classic",
      "hero": "Hero",
      "banner": "Banner"
     }
    },
    "title": {
     "type": "string",
     "enum": [
      "name",
      "logo"
     ],
     "x-wf-labels": {
      "name": "Name",
      "logo": "Logo"
     }
    },
    "logo": {
     "type": "string",
     "maxLength": 0
    },
    "banner": {
     "type": "string",
     "maxLength": 0
    }
   },
   "required": [
    "layout",
    "title",
    "logo",
    "banner"
   ],
   "additionalProperties": false
  },
  "show": {
   "type": "object",
   "properties": {
    "members": {
     "type": "boolean"
    },
    "address": {
     "type": "boolean"
    },
    "purpose": {
     "type": "boolean"
    },
    "share": {
     "type": "boolean"
    }
   },
   "required": [
    "members",
    "address",
    "purpose",
    "share"
   ],
   "additionalProperties": false,
   "x-wf-labels": {
    "members": "Member count",
    "address": "Address",
    "purpose": "What it’s for",
    "share": "Share button"
   }
  },
  "door": {
   "type": "object",
   "properties": {
    "access": {
     "type": "string",
     "enum": [
      "invite",
      "request",
      "open"
     ],
     "x-wf-labels": {
      "invite": "By invitation",
      "request": "Ask to join",
      "open": "Open to anyone"
     },
     "x-wf-door": {
      "invite": "I have an invitation",
      "request": "Knock",
      "open": "Join"
     }
    },
    "label": {
     "type": "string"
    },
    "questions": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "object",
      "properties": {
       "kind": {
        "type": "string",
        "enum": [
         "short",
         "long",
         "choice",
         "agree"
        ],
        "x-wf-labels": {
         "short": "Short answer",
         "long": "Paragraph",
         "choice": "Multiple choice",
         "agree": "Agreement"
        }
       },
       "prompt": {
        "type": "string",
        "maxLength": 200
       },
       "required": {
        "type": "boolean"
       },
       "options": {
        "type": "array",
        "maxItems": 6,
        "items": {
         "type": "string"
        }
       }
      },
      "required": [
       "kind",
       "prompt",
       "required",
       "options"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "access",
    "label",
    "questions"
   ],
   "additionalProperties": false
  },
  "notice": {
   "type": "object",
   "properties": {
    "on": {
     "type": "boolean"
    },
    "kind": {
     "type": "string",
     "enum": [
      "adult",
      "sensitive",
      "custom"
     ],
     "x-wf-labels": {
      "adult": "Over 18s only",
      "sensitive": "Sensitive content",
      "custom": "In your own words"
     },
     "x-wf-notice": {
      "adult": [
       "Over 18s only",
       "You need to be 18 or over to see this."
      ],
      "sensitive": [
       "Sensitive content",
       "This may include things some people find upsetting."
      ],
      "custom": [
       "Before you go in",
       ""
      ]
     }
    },
    "text": {
     "type": "string",
     "maxLength": 140
    }
   },
   "required": [
    "on",
    "kind",
    "text"
   ],
   "additionalProperties": false
  },
  "sharing": {
   "type": "object",
   "properties": {
    "listed": {
     "type": "boolean"
    }
   },
   "required": [
    "listed"
   ],
   "additionalProperties": false
  },
  "mark": {
   "type": "string",
   "maxLength": 0
  },
  "stickers": {
   "type": "array",
   "items": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string",
      "x-wf-format": "sticker"
     },
     "x": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "y": {
      "type": "number",
      "minimum": 0
     },
     "size": {
      "type": "number",
      "minimum": 0.06,
      "maximum": 0.95
     },
     "rot": {
      "type": "integer",
      "minimum": -180,
      "maximum": 180
     },
     "flip": {
      "type": "boolean"
     },
     "colour": {
      "type": "string",
      "enum": [
       "buttons",
       "text",
       "title"
      ],
      "x-wf-labels": {
       "buttons": "Buttons",
       "text": "Text",
       "title": "Title"
      }
     }
    },
    "required": [
     "id",
     "x",
     "y",
     "size",
     "rot",
     "flip"
    ],
    "additionalProperties": false
   }
  },
  "blocks": {
   "type": "object",
   "properties": {
    "root": {
     "type": "object",
     "properties": {
      "type": {
       "const": "root"
      },
      "version": {
       "const": 1
      },
      "direction": {
       "const": "ltr"
      },
      "format": {
       "const": ""
      },
      "indent": {
       "const": 0
      },
      "children": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/widget"
       }
      }
     },
     "required": [
      "type",
      "version",
      "direction",
      "format",
      "indent",
      "children"
     ],
     "additionalProperties": false
    }
   },
   "required": [
    "root"
   ],
   "additionalProperties": false
  }
 },
 "required": [
  "look",
  "header",
  "show",
  "door",
  "notice",
  "sharing",
  "mark",
  "stickers",
  "blocks"
 ],
 "additionalProperties": false,
