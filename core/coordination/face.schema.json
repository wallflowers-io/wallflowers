       "type": "string",
       "x-wf-format": "hex-colour"
      },
      "text": {
       "type": "string",
       "x-wf-format": "hex-colour"
      },
      "title": {
       "type": "string",
       "x-wf-format": "hex-colour"
      }
     },
     "required": [
      "background",
      "cards",
      "buttons",
      "buttonText",
      "text",
      "title"
     ],
     "additionalProperties": false,
     "x-wf-labels": {
      "background": "Background",
      "cards": "Cards",
      "buttons": "Buttons",
      "buttonText": "Button text",
      "text": "Text",
      "title": "Title"
     }
    }
