# /opt/door/door.env — the Door's configuration (mdr/door.md §8). Loopback bind; the
# host's Caddy terminates TLS and is the only way in.
DOOR_PORT=8233
DOOR_PUBLIC=https://app.wallflowers.io
DOOR_AUTH=https://arc.wallflowers.io
DOOR_RELAY=wss://arc.wallflowers.io/v1/relay
# D-33: the passkey's relying party. Every passkey made so far is wallflowers.io's.
DOOR_RP_ID=app.wallflowers.io
# SEC-8: the origins a cookie write may come from besides the Door's own. Name it: unset,
# the Door lists its two loopback development origins.
DOOR_ORIGIN=https://app.wallflowers.io
# D-32's stand-in: app/door/clients.stand-in.json, shipped by deploy-door.sh.
DOOR_CLIENTS=/opt/door/clients.json
# A-3: the kiosk keys /join checks a claim against, shipped by deploy-door.sh. The Arc
# that admits is the relay's origin; DOOR_ARC only where it is not (a rehearsal's gateway).
DOOR_CLAIM_KEYS=/opt/door/claim-keys.json
DOOR_ROOT=/run/door/root
DOOR_REFUSALS=/var/lib/door/refusals.jsonl
# D-34 (c): each person's sealed state, the only copy of their device between sign-ins.
# Unset, the unit's StateDirectory's seals/ (this path), else <DOOR_ROOT>/../seals. Never
# under DOOR_ROOT or a RuntimeDirectory, which a restart clears: the Door refuses to start.
DOOR_SEALS=/var/lib/door/seals
DOOR_WEBAPP=/opt/door/webapp
# Caddy sets CF-Connecting-IP to the peer, overwriting any a client sent, so the caps
# count real networks. Only Caddy reaches the Door (loopback).
DOOR_TRUST_FORWARDED=1
# Sized to the host (D-20, D-30); TBD-13 for the lifetimes. The Door fits sessions and
# the supervisor at DOOR_PROCESS_MIB, and attempts at DOOR_ATTEMPT_MIB, to the unit's
# MemoryMax (NC-48): the sessions first, the attempts what is left. DOOR_MAX_JOINING,
# the kiosk's reserve carved out of the attempts, is an eighth of them unless set (D-55).
DOOR_MAX_SESSIONS=64
DOOR_MAX_ATTEMPTS=512
DOOR_PROCESS_MIB=16
DOOR_ATTEMPT_MIB=4
DOOR_ATTEMPTS_PER_ADDR=4
DOOR_ATTEMPT_SECS=60
DOOR_SIGNUP_SECS=300
DOOR_IDLE_SECS=900
DOOR_TOKEN_SECS=3600
